# Copyrighted sample — user's local copy only
samples/Les_annees.epub

# dict.cc exports — personal-use license, users must download themselves
samples/dict.cc-*/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
dist/
build/
*.egg

# Caches for downloaded Wiktionary/Kaikki dumps and built indexes
.cache/
/cache/

# Calibre plugin: ell/ and vendor/ are populated at build time, not by hand.
# Keep the .gitkeep / README.md placeholders so the empty dirs are tracked.
calibre-plugin/ell/*
!calibre-plugin/ell/.gitkeep
calibre-plugin/vendor/*
!calibre-plugin/vendor/README.md

# Node / Playwright
node_modules/
playwright-report/
test-results/
.playwright/

# Editor
.vscode/
.idea/
*.swp
